{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "koenami",
  "main": "worker.ts",
  "account_id": "5e6d5236e83c2395b253db1ec8e28a3e",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "routes": [{ "pattern": "koe.transnavi.jp", "custom_domain": true }],
  "assets": {
    "directory": ".deploy/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "containers": [{
    "class_name": "VoiceAnalyzer",
    "image": "./Dockerfile",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "durable_objects": { "bindings": [{ "name": "ANALYZER", "class_name": "VoiceAnalyzer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceAnalyzer"] }],
  "ratelimits": [{ "name": "ANALYSIS_LIMIT", "namespace_id": "2001", "simple": { "limit": 180, "period": 60 } }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
