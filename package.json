  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.131.2"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.15.0"
  },
  "license": "MIT",
  "description": "Japanese-first voice practice with audible references and a live acoustic map",
  "repository": {
    "type": "git",
    "url": "https://github.com/transnavi/koenami.git"
  }
}
