{
  "name": "koenami",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "vite build",
    "build:public": "npm run build && .venv/bin/python prepare_public.py",
    "check:worker": "wrangler types && tsc",
    "deploy": "npm run build:public && wrangler deploy",
    "test:unit": "vitest run --config tests/vitest.config.ts",
    "test:unit:coverage": "vitest run --config tests/vitest.config.ts --coverage",
    "checkout:old": "node tests/scripts/checkout-old.mjs",
    "coverage:check": "node tests/coverage/check.mjs",
    "coverage:check:unit": "node tests/coverage/check.mjs --only=math,space,cloud,storage,corpus-import,capture,sw",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:record": "tests/scripts/record-e2e.sh",
    "check:tests": "tsc -p tests/tsconfig.json",
    "check:unit": "bun run test:unit:coverage && bun run coverage:check:unit",
    "coverage:browser": "node tests/coverage/browser.mjs",
    "check:all": "bun run test:unit:coverage && bun run test:e2e && bun run coverage:report && bun run coverage:check"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.3",
    "fake-indexeddb": "6.2.5",
    "istanbul-lib-coverage": "3.2.2",
    "monocart-coverage-reports": "^2.13.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "vitest-monocart-coverage": "4.0.2",
    "wrangler": "4.131.2"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "@zip.js/zip.js": "2.15.0"
  },
  "license": "MIT",
  "description": "Japanese-first voice practice with audible references and a live acoustic map",
  "repository": {
    "type": "git",
    "url": "https://github.com/transnavi/koenami.git"
  }
}
