{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		// e2e/model runs under node --experimental-strip-types, which resolves .ts imports as written.
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"paths": { "@app/*": ["../src/lib/*"], "$lib/*": ["../src/lib/*"] }
	},
	"include": [
		"unit/**/*.ts",
		"vitest.config.ts",
		"../e2e/**/*.ts",
		"../playwright.config.ts",
		"../src/lib/audio-worklet.d.ts"
	]
}
