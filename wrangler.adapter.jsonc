// Read by adapter-cloudflare only (svelte.config.js): where the Kit build goes. Deployment
// uses wrangler.jsonc, whose entry (worker/entry.ts) re-exports this worker.
{
  "name": "koenami",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" }
}
